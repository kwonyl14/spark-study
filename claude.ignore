# ----------------------------------------------------
# 1. 버전 관리 및 IDE 설정 파일
# ----------------------------------------------------
.git/
.gitignore
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store

# ----------------------------------------------------
# 2. Python 관련 제외 항목 (가장 토큰을 많이 먹는 주범)
# ----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
lib/
lib64/
x64/
x86/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.poetry/
.pip-env/

# ----------------------------------------------------
# 3. Go (Golang) 관련 제외 항목
# ----------------------------------------------------
# Go는 의존성(vendor) 폴더에 타인들의 코드가 통째로 들어가므로 반드시 제외해야 합니다.
vendor/
bin/
pkg/
*.out
*.test
*.prof

# ----------------------------------------------------
# 4. 데이터베이스 및 로그, 환경변수 (보안 및 노이즈 제거)
# ----------------------------------------------------
*.log
*.sqlite3
*.db
.env
.env.local
.env.*.local

# ----------------------------------------------------
# 5. 기타 빌드 산출물 및 대용량 파일
# ----------------------------------------------------
node_modules/
out/
target/
*.zip
*.tar.gz
*.rar
*.7z
*.iso
*.exe
*.dll
*.so
*.dylib
